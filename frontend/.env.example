# Production-shaped schema-v1 UI. Set true only when intentionally using mock data.
VITE_DEMO_MODE=false
VITE_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
VITE_TREASURY_ADDRESS=0x7fF88afF5D8AEA666582730AD81F49b3C303A3d3
VITE_FACTORY_ADDRESS=0x52C36499AA400F74432Eb327Cd1fB51Be573AeEd
VITE_AGENT_SUBMIT_ADDRESS=0xB1D19F71d68c4e7065749e8593D338E9A30D654f
VITE_EXPLORER_BASE_URL=https://creditcoin-testnet.blockscout.com

# Public Thirdweb client id. Never put a secret key in a VITE_ variable.
VITE_THIRDWEB_CLIENT_ID=""

# Optional: block where the schema-v1 factory was deployed. Supplying it makes
# owner-based TreasuryCreated discovery faster and avoids wide eth_getLogs ranges.
VITE_FACTORY_DEPLOYMENT_BLOCK=""

# Optional controlled demo faucet. Set only after ControlledDemoFaucet is deployed
# and funded with fwWCTC/fwUSD. It can fund only factory-created treasuries once.
VITE_DEMO_FAUCET_ADDRESS=""

# Optional non-authoritative observability projection.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_REASONING_API_URL=""
