# Demo mode (default) shows illustrative sample data with no live network calls.
VITE_DEMO_MODE=true

# Set VITE_DEMO_MODE=false and fill these in to point at a real deployment:
VITE_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# DEFAULT treasury instance to query. With the V2 multi-tenant pivot, any factory-deployed
# instance can also be viewed by pasting its address in the viewer's instance switcher —
# its immutable guardrails are then read live from the instance itself.
VITE_TREASURY_ADDRESS=0x13CACe3989b295048De47C68F32Ff3d844AC2026
# The permissionless ASCTreasuryFactory that deployed the instances (display-only — it
# deliberately keeps no tenant registry, so instances are addressed directly).
VITE_FACTORY_ADDRESS=0x97c81D68BbCDb1A673b61176d60F071963Abe7f2
# Instance discovery: `public/tenants.json` (same origin) is the committed output of
# `contracts/script/index-tenants.js`, which scans the factory's TreasuryDeployed events.
# The dashboard lists those instances as switcher chips ("From on-chain index"). Guards:
# only identity (label/address/owner) is indexed — guardrails are always read LIVE from
# the instance itself. Regenerate after new tenants: `cd contracts && node script/index-tenants.js`
# then copy `out/tenants.scanned.json` over `frontend/public/tenants.json`.
# Must serve agent/src/reasoningStore.ts's payloads over HTTP as <hash>.json — see
# docs/DEPLOYMENT.md. A local file store isn't reachable from a browser as-is.
VITE_REASONING_API_URL=""
# Thirdweb embedded wallet (non-custodial email/social sign-up).
# Client ID is public (not a secret) — get it from thirdweb.com dashboard.
VITE_THIRDWEB_CLIENT_ID=""
VITE_EXPLORER_BASE_URL=https://creditcoin-testnet.blockscout.com
VITE_AGENT_SUBMIT_ADDRESS=0xB1D19F71d68c4e7065749e8593D338E9A30D654f
# Stage 4b/4c — optional Supabase auth<->address mapping (dashboard "Your instances").
# ANON/publishable key only (never the service-role key). Requires the migration in
# frontend/supabase/migrations/0001_user_instances.sql. When unset the dashboard shows
# a clear note and falls back to on-chain owner enumeration.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
