# --- Schema-v1 product runner ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/

SOURCE_CHAIN_KEY=1
SOURCE_CHAIN_ID=11155111
CREDITCOIN_CHAIN_ID=102031
MARKET_OBSERVER_ADDRESS=0x9bAF94da27d5C71c42b40D25b43070083DE7296E
SOURCE_POOL_ADDRESS=0xB88deB0436eAD37A6Dd625e9140AE45D5024424f
FACTORY_ADDRESS=0x494490bBF748e59a659227F46510535BF3818442
FACTORY_DEPLOYMENT_BLOCK=5465730
DEX_ADAPTER_ADDRESS=0x9bAF94da27d5C71c42b40D25b43070083DE7296E

# Separate low-privilege roles. Never commit real values.
AGENT_SUBMIT_PRIVATE_KEY=0x...
SEPOLIA_OBSERVER_PRIVATE_KEY=0x...

# Railway onboarding gas sponsor. Use a dedicated CC3 testnet wallet with only the
# amount you are willing to spend during the demo.
GAS_SPONSOR_PRIVATE_KEY=0x...
GAS_SPONSOR_TARGET_WEI=250000000000000000
GAS_SPONSOR_MAX_TOPUP_WEI=250000000000000000
# Cheap hackathon abuse controls: total amount the process may sponsor during one UTC day,
# and minimum time before the same address can receive another successful top-up.
GAS_SPONSOR_DAILY_BUDGET_WEI=2500000000000000000
GAS_SPONSOR_ADDRESS_COOLDOWN_MS=86400000
SPONSOR_ALLOWED_ORIGINS=https://fair-witness.vercel.app
# Railway supplies PORT automatically.

GEMINI_API_KEY=your_key_from_ai_studio
GEMINI_MODEL=gemini-3.1-flash-lite

POLL_INTERVAL_MS=45000
CONFIRM_OBSERVATION_DELAY_MS=15000
MAX_TENANTS_PER_CYCLE=50
FACTORY_LOG_CHUNK_SIZE=25000
PROOF_BUILDER_TIMEOUT_MS=120000

# Optional server-side audit projection only. Do not expose this service-role key to Vite.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# --- Legacy runner only (npm run dev:legacy / start:legacy) ---
