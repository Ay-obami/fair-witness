# --- Schema-v1 product runner ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/

# Controlled public-testnet source path. SOURCE_CHAIN_KEY=1 is the Attestcoin key
# used by the current Sepolia schema-v1 deployment; confirm against ChainInfo if the
# environment changes.
SOURCE_CHAIN_KEY=1
SOURCE_CHAIN_ID=11155111
CREDITCOIN_CHAIN_ID=102031
MARKET_OBSERVER_ADDRESS=0x9bAF94da27d5C71c42b40D25b43070083DE7296E
SOURCE_POOL_ADDRESS=0xB88deB0436eAD37A6Dd625e9140AE45D5024424f
FACTORY_ADDRESS=0x52C36499AA400F74432Eb327Cd1fB51Be573AeEd
DEX_ADAPTER_ADDRESS=0x9bAF94da27d5C71c42b40D25b43070083DE7296E

# Separate low-privilege roles. Never commit real values.
AGENT_SUBMIT_PRIVATE_KEY=0x...      # Creditcoin gas + submitProposal only; holds no treasury assets
SEPOLIA_OBSERVER_PRIVATE_KEY=0x...  # Sepolia gas for permissionless pool-derived observations only

# AI is advisory only. It returns EXECUTE/WAIT; deterministic code chooses strategy
# and every execution field, and the treasury independently revalidates on-chain.
GEMINI_API_KEY=your_key_from_ai_studio
GEMINI_MODEL=gemini-3.1-flash-lite

# Product runner cadence/discovery.
POLL_INTERVAL_MS=45000
CONFIRM_OBSERVATION_DELAY_MS=15000
FACTORY_DEPLOYMENT_BLOCK=0
MAX_TENANTS_PER_CYCLE=50
PROOF_BUILDER_TIMEOUT_MS=120000

# Optional non-authoritative observability projection.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# --- Legacy runner only (npm run dev:legacy / start:legacy) ---
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
# ETHEREUM_RPC_URLS=https://mainnet.infura.io/v3/YOUR_KEY,https://ethereum-rpc.publicnode.com
TREASURY_ADDRESS=0x...
TREASURY_OWNER_PRIVATE_KEY=0x...
