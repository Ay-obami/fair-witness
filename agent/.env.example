# --- Sepolia (source chain) ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# Optional comma-separated backup read endpoints — tried in order when the primary read
# fails (public Sepolia RPCs degrade in waves; the watcher pins whichever endpoint worked).
# SEPOLIA_RPC_URLS=https://sepolia.infura.io/v3/YOUR_KEY,https://1rpc.io/sepolia
PRICE_CONTRACT_ADDRESS=0x...   # toy price-observation contract (see contracts week-1 note)

# --- Creditcoin (destination chain) ---
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/
TREASURY_ADDRESS=0x...          # deployed ASCTreasuryJournal address (single-tenant mode)
AGENT_SUBMIT_PRIVATE_KEY=0x...  # LOW-PRIVILEGE key — pays gas only, must hold zero token balance

# --- Multi-tenant mode (optional; see docs/ARCHITECTURE_V2.md §3.1) ---
# Set TENANTS_FILE to a JSON registry ({ "tenants": [ { "label", "treasuryAddress" } ] })
# and ONE agent process polls every instance: fact-scoped proofs are built once per cycle
# and each tenant gets its own decision/submission against ITS contract only. When
# TENANTS_FILE is set, TREASURY_ADDRESS is ignored. When running multiple tenants, set
# MIN_ARB_WIDTH_BPS_LOCAL_ESTIMATE to the LOOSEST tenant's minArbWidthBps floor (the
# pre-filter must never be tighter than the loosest tenant, or you'd skip facts that
# tenant could legally act on).
# TENANTS_FILE=tenants.json

# --- Attestcoin chain identifiers (confirm via PrecompileChainInfoProvider.getSupportedChains()) ---
SOURCE_CHAIN_KEY=1

# --- LLM decision layer ---
GEMINI_API_KEY=your_key_from_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# --- Agent behavior ---
POLL_INTERVAL_MS=30000
MIN_ARB_WIDTH_BPS_LOCAL_ESTIMATE=80   # pre-flight filter only; contract enforces the real bound
CONFIRM_GAP_TARGET_BLOCKS=3
